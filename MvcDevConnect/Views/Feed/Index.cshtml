@using Microsoft.IdentityModel.Tokens
@model List<MvcDevConnect.Models.TbPublicacao>;

@{
    ViewData["Title"] = "Feed";
}

<link rel="stylesheet" href="~/css/feed.css">

<script defer>
    let novaPublicacaoCadastrada = "@ViewBag.PublicacaoCadastrada";


    if (novaPublicacaoCadastrada == "Nao Cadastrada") {
        alert("Publicação não cadastrada! Tente novamente")
    }
    else if (novaPublicacaoCadastrada == "Cadastrada") {
        alert("Publicação postada...")
    }

</script>



<h1>Tela Feed</h1>

<header id="cabeçalho">

    <nav>

        <a id="logo-desktop" asp-controller="Home" asp-action="Index"> <img src="../images/Logo tipo_SemfundoMd.svg"
                alt=""> </a>
        <a id="logo-mobile" asp-controller="Home" asp-action="Index"> <img src="../images/Logo tipo_SemfundoSm.svg"
                alt=""> </a>

        <div class="cabeçalho-ações">
            <a asp-controller="Feed" asp-action="Index"> <img src="../images/icone Casa (4).svg" alt=""> </a>
            <a href="#"> <img src="../images/Search.svg" alt="logo DevConnect"> </a>
            <a asp-controller="Usuario" asp-action="Perfil"> <img class="foto-usuario" src="../images/_image.webp"
                    alt=""> </a>
        </div>

    </nav>

</header>

<main>

    <div class="container-flex-publi">

        <nav class="storys" id="formulario" enctype="multipart/form-data" method="post" asp-controller="Feed"
            asp-action="Index">

            <article class="cardstory">
                <a href="#"> <img class="foto-usuario" src="../images/transferir.jpg" alt=""> <span>Calango_</span>
                </a>
            </article>

            <article class="cardstory">
                <a href="#"> <img class="foto-usuario" src="../images/transferir (1).jpg" alt="">
                    <span>zerao@official</span> </a>
            </article>

            <article class="cardstory">
                <a href="#"> <img class="foto-usuario" src="../images/transferir (2).jpg" alt="">
                    <span>GaLaXY</span>
                </a>
            </article>

            <article class="cardstory">
                <a href="#"> <img class="foto-usuario" src="../images/channels4_profile.jpg" alt="">
                    <span>Alanzoka_Nextstage</span> </a>
            </article>

            <article class="cardstory">
                <a href="#"> <img class="foto-usuario"
                        src="../images/29668a42-6969-48c5-9f67-467681b5720a-profile_image-300x300.png" alt="">
                    <span>CappucinoMafios0</span> </a>
            </article>

            <article class="cardstory">
                <a href="#"> <img class="foto-usuario" src="~/images/images (1).jpg" alt=""> <span>MrFall_</span>
                </a>
            </article>



            <article class="cardstory">
                <a href="#"> <img class="foto-usuario" src="~/images/transferir.jpg" alt=""> <span>Calango_</span>
                </a>
            </article>

            <article class="cardstory">
                <a href="#"> <img class="foto-usuario" src="~/images/transferir (1).jpg" alt="">
                    <span>zerao@official</span> </a>
            </article>

            <article class="cardstory">
                <a href="#"> <img class="foto-usuario" src="~/images/transferir (2).jpg" alt="">
                    <span>GaLaXY</span>
                </a>
            </article>

            <article class="cardstory">
                <a href="#"> <img class="foto-usuario" src="~/images/channels4_profile.jpg" alt="">
                    <span>Alanzoka_Nextstage</span> </a>
            </article>

            <article class="cardstory">
                <a href="#"> <img class="foto-usuario"
                        src="~/images/29668a42-6969-48c5-9f67-467681b5720a-profile_image-300x300.png" alt="">
                    <span>CappucinoMafios0</span> </a>
            </article>

            <article class="cardstory">
                <a href="#"> <img class="foto-usuario" src="~/images/images (1).jpg" alt=""> <span>MrFall_</span>
                </a>
            </article>


        </nav>

        <Section class="publicar" id="formulario">

            <h2>publicar</h2>

            <form enctype="multipart/form-data" method="post" asp-controller="Feed" asp-action="Index">
                <textarea name="Descricao" id="escrever-texto" placeholder="Digite a descrição do post..."
                    required></textarea>


                <footer>

                    <label class="formulario-imput-file" for="upload-imagem">Faça o upload da sua imagem
                        aqui</label>
                    <input type="file" name="imagem" id="upload-imagem">

                    <button type="submit" class="formulario-botao-azul">Postar</button>

                </footer>

            </form>

        </Section>


        <section>

            @foreach (TbPublicacao publi in Model)
            {
                if (!publi.ImagemUrl.IsNullOrEmpty())
                {
                    <article class="posts" id="formulario">

                        <header class="cardpost">

                            <a href="#"> <img class="foto-usuario" src="~/images/@publi.IdUsuarioNavigation?.FotoPerfilUrl" alt="">

                                <span>@publi.IdUsuarioNavigation?.NomeDeUsuario</span>

                            </a>

                        </header>

                        <figure>

                            <img src="~/images/@publi.ImagemUrl" alt="post_calango">

                            <figcaption class="descrição-publicação">


                                <div class="interações-posts">

                                    <span>156k Curtidas</span>

                                    <button> <img class="post-ações" src="../images/icone Heart (4).svg"
                                            alt="icone-Heart"></button>
                                    <button> <img class="post-ações" src="../images/icone-Comentário (1).svg"
                                            alt="icone icone-Comentário"> </button>

                                </div>

                                <p>@publi.Descricao</p>


                                <button> ver todos os comentários... </button>
                            </figcaption>

                        </figure>

                    </article>
                }
                else
                {
                    <article class="posts" id="formulario">

                        <header class="cardpost">

                             <a href="#"> <img class="foto-usuario" src="~/images/@publi.IdUsuarioNavigation?.FotoPerfilUrl" alt="">

                                <span>@publi.IdUsuarioNavigation?.NomeDeUsuario</span>

                            </a>

                        </header>

                        <figure>

                            <figcaption class="descrição-publicação">


                                <div class="interações-posts">

                                    <span>156k Curtidas</span>

                                    <button> <img class="post-ações" src="../images/icone Heart (4).svg"
                                            alt="icone-Heart"></button>
                                    <button> <img class="post-ações" src="../images/icone-Comentário (1).svg"
                                            alt="icone icone-Comentário"> </button>

                                </div>

                                <p>@publi.Descricao</p>


                                <button> ver todos os comentários... </button>
                            </figcaption>

                        </figure>

                    </article>
                }
            }

        </section>

    </div>
</main>