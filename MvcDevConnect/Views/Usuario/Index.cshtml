@model MvcDevConnect.Models.TbUsuario



@{
    ViewData["Title"] = "Cadastro";
}

    <!-- CSS -->


    <link rel="stylesheet" href="~/css/global.css">
    <link rel="stylesheet" href="~/css/cadastro.css">

<script defer>
const UsuarioNovoCadastrado = "@ViewBag.UsuarioNovoCadastrado";


if(UsuarioNovoCadastrado == "Nao cadastrado")
{
    alert("Usuário não cadastrado! Tente novamente")
}

</script>

    <h1> Tela Cadastro</h1>

    <main>
        <div>
            <!-- Formulario -->
            <form id="formulario" enctype="multipart/form-data" method="post" asp-controller="Usuario" asp-action="Index">

                <img src="../images/Logo tipo_ Light SM.svg" alt="Logo-DevConnection">
                <p>Cadastre-se para a nossa comunidade exclusiva de desenvolvedores(as)</p>

                <div>
                    <label for="">Nome e sobrenome:</label>
                    <input type="text" asp-for="NomeCompleto" id="" class="formulario-botao-cinza">
                </div>

                <div>
                    <label for="">Nome de usuário:</label>
                    <input type="text" asp-for="NomeDeUsuario" id="" class="formulario-botao-cinza">
                </div>

                <div>
                    <label for="">E-mail:</label>
                    <input type="email" asp-for="Email" id="" class="formulario-botao-cinza">
                </div>

                <div>
                    <label for="">Senha:</label>
                    <input type="password" asp-for="Senha" id="" class="formulario-botao-cinza">
                </div>

                <div>
                    <label class="formulario-imput-file" for="upload-imagem">Faça o upload da sua imagem aqui</label>
                    <input type="file" name="imagem" id="upload-imagem">
                </div>

                <button type="submit" class="formulario-botao-azul">Cadastrar-se</button>

            </form>


            <section id="seção-login">

                <p> Já tem uma conta? <a asp-controller="Home" asp-action="Index"> Conecte-se </a></p>

            </section>


        </div>
    </main>