@using Microsoft.IdentityModel.Tokens
@model List<MvcDevConnect.Models.TbPublicacao>;

<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <meta name="author" content="DevConnect - Lucas S">
    <meta name="description" content="Site feito pela DevConnection para conectar os desenvolvedores">
    <meta name="keywords"
        content="Rede social, desenvolvedores, desenvolvimento, DevConnect, code, codigos, conexão, Dev, Developers">

    <title>DevConnect - perfil</title>
    <link rel="shortcut icon" href="../images/Logo tipo_ Dark.svg" type="image/x-icon">

    <!-- CSS -->


    <link rel="stylesheet" href="~/css/global.css">
    <link rel="stylesheet" href="~/css/perfil.css">

</head>



    <h1>tela perfil</h1>

    <header id="cabeçalho">

        <nav>

            <a id="logo-desktop" href="./feed.html"> <img src="../images/Logo tipo_SemfundoMd.svg" alt=""> </a>
            <a id="logo-mobile" href="./feed.html"> <img src="../images/Logo tipo_SemfundoSm.svg" alt=""> </a>

            <div class="cabeçalho-ações">
                <a href="./feed.html"> <img src="../images/icone Casa (4).svg" alt=""> </a>
                <a href="#"> <img src="../images/Search.svg" alt="logo DevConnect"> </a>
                <a href="./perfil.html"> <img class="foto-usuario" src="../images/_image.webp" alt=""> </a>
            </div>

        </nav>

    </header>

    <main>

        <header class="detalhes-usuario">

            <section>

                <img class="foto-perfil" src="../images/_image.webp" alt="usuario">

                <div class="informações-usuario">

                    <div>

                        <p>BRKsEDU_</p>
                        <p>eduardo pugliese</p>

                    </div>

                    <nav>
                        <a href="#" class="info-publiseguidores">246 publicações</a>
                        <a href="#" class="info-publiseguidores">43k seguidores</a>
                        <a href="#" class="info-publiseguidores">10k seguindo</a>

                    </nav>

                    <a asp-controller="Usuario" asp-action="EditorDePerfil">editar perfil</a>

                </div>

            </section>

        </header>

        <div class="alinhamento-icone-publi">
            <img src="../images/Galeria (4).svg" alt="">
            <h2>publicações</h2>
        </div>

        <div class="container-flex-publi-usuario">

            <article class="posts" id="formulario">

                <header class="cardpost">

                    <a href="#">

                        <img class="foto-usuario" src="../images/_image.webp" alt="">

                        <span> BRKsEDU_</span>

                    </a>
                    
                </header>

                    <figure>

                        <img src="../images/maxresdefault.jpg" alt="">


                        <figcaption class="descrição-publicação">

                            <div class="interações-posts">

                                <span>74k Curtidas</span>

                                <button> <img class="post-ações" src="../images/icone Heart (4).svg"
                                        alt="icone-Heart"></button>
                                <button> <img class="post-ações" src="../images/icone-Comentário (1).svg"
                                        alt="icone icone-Comentário"> </button>

                            </div>

                            <p>fui para a italia com meus amigos e olha no que deu</p>
    
                            <button id="mostrar-comentários"> ver todos os comentários... </button>

                            

                        </figcaption>


                    </figure>
            </article>
        </div>
    </main>


</html>